# Supabase project URL (public — safe in the browser).
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon / publishable key (public — RLS is what protects data).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service-role / secret key. Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Canonical site origin, e.g. https://creatorskootam.in (used for OAuth redirects and OG URLs).
NEXT_PUBLIC_SITE_URL=
# WhatsApp Community invite link — server only, never NEXT_PUBLIC_. Format: https://chat.whatsapp.com/<code>
WA_COMMUNITY_URL=
# FRAME KOOTAM (creators) group invite link — server only, never NEXT_PUBLIC_.
WA_CREATORS_URL=
# CUT KOOTAM (editors) group invite link — server only, never NEXT_PUBLIC_.
WA_EDITORS_URL=
# Optional room for the "other" lane — server only, never NEXT_PUBLIC_. Empty = they get the community link only.
WA_OTHER_URL=
# Comma-separated admin emails allowed into /admin (checked server-side).
ADMIN_EMAILS=
